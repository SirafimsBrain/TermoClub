    "scrollback": {
      "type": "integer",
      "label": "Scrollback",
      "description": "Lines of history kept in the screen buffer.",
      "default": 1000,
      "min": 0,
      "max": 10000,
      "requires_restart": true
    },
    "copy_on_select": {
      "type": "boolean",
      "label": "Copy on select",
      "default": false
    },
    "bell": {
      "type": "boolean",
      "label": "Terminal bell",
      "description": "React to BEL from programs.",
      "default": false
